# Personal SQLite data, imported books/audio, accounts and sessions
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal

# Local environment configuration; never commit env files or templates
.env
.env.*
.secrets/
secrets/
*.key
*.p12
*.pfx
*-private.pem
private-key*.pem

# ChatGPT login credentials and accidental exports (also outside .data)
credentials.bin
credentials*.json
chatgpt-auth*.json
chatgpt-host.json
auth.json
tokens.json
*.token

# Server runtime files, local backups and installed dependencies
logs/
*.log
*.pid
*.pid.lock
.backups/
*.sqlite.bak
*.db.bak
node_modules/

# Local documentation; keep off GitHub
/docs/
