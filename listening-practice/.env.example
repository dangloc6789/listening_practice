# Local defaults. Copy to .env only for overrides. Do not commit .env.
HOST=127.0.0.1
PORT=4173
APP_TIMEZONE=Asia/Bangkok
# DATA_DIR=D:/Codex/listening-practice/.data

# Set these only after preparing an HTTPS reverse proxy and an external OAuth provider.
# PUBLIC_ORIGIN=https://listening.example.com
# OAUTH_ISSUER=https://your-identity-provider.example.com/
# OAUTH_AUDIENCE=https://listening.example.com/mcp
# OAUTH_JWKS_URI=https://your-identity-provider.example.com/.well-known/jwks.json
# OAUTH_SUBJECT=the-exact-owner-subject-from-your-identity-provider
# OAUTH_SCOPE=progress:read
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:6274

# MCP_LOCAL_TOKEN is only for local MCP Inspector/tooling; not ChatGPT OAuth.
# Generate your own random value of >=32 characters; never paste it in a URL or frontend.
# MCP_LOCAL_TOKEN=
